    "@langchain/openai": "^1.8.4",
    "@mediapipe/tasks-vision": "^1.2.3",
    "deepagents": "^1.16.5",
    "langchain": "^1.6.6",
    "three": "^0.187.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/three": "^0.187.0",
