{
  "name": "oneinthree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode offline",
    "dev:phone": "vite --mode phone",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "set-key": "sh scripts/set-key.sh",
    "airpods": "sh tools/airpods-helper/build.sh",
    "gen:voice": "node scripts/gen-voice.mjs",
    "gen:sfx": "node scripts/gen-sfx.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "three": "^0.187.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
