# Copy this file to .dev.vars (gitignored) and paste your ElevenLabs API key.
# The Worker reads ELEVENLABS_API_KEY. The browser never sees it.
#   cp .dev.vars.example .dev.vars
# or: npm run set-key
#
# Production: npx wrangler secret put ELEVENLABS_API_KEY
ELEVENLABS_API_KEY=

# Live voice (optional). Create the agent with `npm run agent:create` after the
# key is set, then paste the printed id here. Without it, L stays on the
# push-to-talk pipeline (speech-to-text, the line model, text-to-speech).
# Production: npx wrangler secret put ELEVENLABS_AGENT_ID
ELEVENLABS_AGENT_ID=

# Optional. Default is gemini-3.5-flash (the low-latency Gemini ElevenLabs
# routes live calls onto). gemini-4-argon is the larger Gemini.
# ELEVENLABS_AGENT_LLM=gemini-3.5-flash
